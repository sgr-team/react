{
  "name": "examples-books",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "example:build": "next build",
    "example:test": "jest",
    "example:lint": "next lint",
    "start": "next start",
    "dev": "next dev --turbopack",
    "dev-env": "npm run dev-env-up && npm run dev-env-migrate",
    "dev-env-up": "docker compose up -d --wait",
    "dev-env-down": "docker compose down",
    "dev-env-clear": "npm run dev-env-down && rm -rf ./.local-data",
    "dev-env-recreate": "npm run dev-env-clear && npm run dev-env-up",
    "dev-env-migrate": "db-migrate up"
  },
  "dependencies": {
    "@sgrnext/api": "^0.1.0",
    "@sgrnext/api-parse": "^0.1.0",
    "@types/pg": "^8.11.11",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "next": "15.2.3",
    "pg": "^8.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.2.3",
    "jest": "^29.7.0",
    "typescript": "^5"
  }
}
